# Server
PORT=5000
NODE_ENV=development

# Database
DB_PATH=./data/fuelwatch.db

# JWT
JWT_SECRET=fuelwatch_tuguegarao_dev_secret_change_in_production_2024
JWT_EXPIRES_IN=7d

# Session (for OAuth handshake only)
SESSION_SECRET=fuelwatch_session_secret_change_in_production

# Uploads
UPLOADS_DIR=./uploads
MAX_FILE_SIZE_MB=5

# CORS / Frontend
CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Stale price threshold in days
STALE_PRICE_DAYS=7

# Spam prevention
SPAM_INTERVAL_MINUTES=30

# ─── Google OAuth ──────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=70803645380-l08ssr2a55kqdhjfhh05puipj719oqhs.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=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
