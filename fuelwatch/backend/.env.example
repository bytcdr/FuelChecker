# Server
PORT=5000
NODE_ENV=development

# Database
DB_PATH=./data/fuelwatch.db

# JWT
JWT_SECRET=change_this_to_a_long_random_secret_string_at_least_32_chars
JWT_EXPIRES_IN=7d

# Session (needed only for the Google OAuth redirect handshake)
SESSION_SECRET=change_this_session_secret_too

# Uploads
UPLOADS_DIR=./uploads
MAX_FILE_SIZE_MB=5

# CORS / Frontend URL
CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Stale price threshold in days
STALE_PRICE_DAYS=7

# Spam prevention: minimum minutes between same-user same-station-product submissions
SPAM_INTERVAL_MINUTES=30

# ─── Google OAuth ──────────────────────────────────────────────────────────────
# Setup steps:
# 1. Go to https://console.cloud.google.com/
# 2. Create a project → APIs & Services → Credentials → Create OAuth 2.0 Client ID
# 3. Application type: Web application
# 4. Authorized redirect URIs: http://localhost:5000/api/auth/google/callback
# 5. Copy Client ID and Client Secret below
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback
