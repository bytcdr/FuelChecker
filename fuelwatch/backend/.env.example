# Server
PORT=5000
NODE_ENV=development

# Database
DB_PATH=./data/fuelwatch.db

# JWT
JWT_SECRET=change_this_to_a_long_random_secret_string_at_least_32_chars
JWT_EXPIRES_IN=7d

# Uploads
UPLOADS_DIR=./uploads
MAX_FILE_SIZE_MB=5

# CORS - set to your frontend URL
CORS_ORIGIN=http://localhost:3000

# Stale price threshold in days (prices older than this are marked stale)
STALE_PRICE_DAYS=7

# Spam prevention: minimum minutes between same-user same-station-product submissions
SPAM_INTERVAL_MINUTES=30
