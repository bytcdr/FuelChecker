# Frontend Environment Variables
# These are exposed to the browser - do NOT put secrets here

VITE_API_BASE_URL=http://localhost:5000/api

# MapLibre tile URL (OSM compatible)
# Default: OpenStreetMap raster tiles
VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_TILE_ATTRIBUTION=© OpenStreetMap Contributors

# Default map center (Tuguegarao City)
VITE_MAP_CENTER_LAT=17.6132
VITE_MAP_CENTER_LNG=121.7270
VITE_MAP_DEFAULT_ZOOM=13

# App name
VITE_APP_NAME=FuelWatch Tuguegarao
